{
  "name": "lingo-frame",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "e2e": "pnpm build:e2e && playwright test",
    "check": "pnpm i18n:check && pnpm typecheck && pnpm test && pnpm build",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui extract --clean && lingui compile --strict"
  },
  "dependencies": {
    "@lingui/core": "^6.7.0",
    "markdown-it": "^15.0.2",
    "reka-ui": "^2.10.4",
    "turndown": "^7.2.4",
    "vue": "^3.5.39",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lingui/cli": "^6.7.0",
    "@lingui/extractor-vue": "^6.7.0",
    "@lingui/format-po": "^6.7.0",
    "@lingui/vite-plugin": "^6.7.0",
    "@playwright/test": "^1.61.1",
    "@types/chrome": "^0.2.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-vue": "^1.0.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.10.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.0.8",
    "wxt": "^0.20.27"
  }
}
